day06- DSA journey in leetcode topic Arrays / 3sumclosest

https://leetcode.com/problems/3sum-closest/submissions/2137180241


class Solution:
    def threeSumClosest(self, nums, target):
        nums.sort()
        n = len(nums)
        ans = nums[0] + nums[1] + nums[2]

        for i in range(n - 2):
            l = i + 1
            r = n - 1
            while l < r:
                curr = nums[i] + nums[l] + nums[r]

                if abs(curr - target) < abs(ans - target):
                    ans = curr

                if curr < target:
                    l += 1
                elif curr > target:
                    r -= 1
                else:
                    return target
        return ans