day10-DSA journey leetcode in array/next permutation


https://leetcode.com/problems/next-permutation/submissions/2141658446

class Solution:
    def nextPermutation(self, nums):
        n = len(nums)
        i = n - 2

        # 1. Find first decreasing element from right
        while i >= 0 and nums[i] >= nums[i+1]:
            i -= 1

        # 2. If found, swap with just larger element from right
        if i >= 0:
            j = n - 1
            while nums[j] <= nums[i]:
                j -= 1
            nums[i], nums[j] = nums[j], nums[i]

        # 3. Reverse the suffix
        left = i + 1
        right = n - 1
        while left < right:
            nums[left], nums[right] = nums[right], nums[left]
            left += 1
            right -= 1