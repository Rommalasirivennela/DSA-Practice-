day 04 - DSA leetcode 
longest common prefix -array leetcode 

https://leetcode.com/problems/longest-common-prefix/submissions/2135406528

class Solution:
    def longestCommonPrefix(self, strs):
        if not strs:
            return ""
        prefix = strs[0]
        for s in strs[1:]:
            while not s.startswith(prefix):
                prefix = prefix[:-1]
                if prefix == "":
                    return ""
        return prefix
